# Target configuration for the existing EC2 HTTP server block.
# Merge the location into the current server block; preserve its server_name and other settings.
# Host Nginx sends all paths to frontend 127.0.0.1:8080. The frontend container's Nginx
# serves the SPA and proxies /api/ internally to the Docker service backend:8000.

server {
    listen 80;
    server_name 13.125.215.42; # Update if the public IP changes or a domain is assigned.

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
