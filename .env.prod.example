# Copy to .env.prod on the EC2 host and replace placeholders. Never commit .env.prod.
# Backend image tag was verified in ECR. Tags are raw 40-character commit SHAs.
BACKEND_IMAGE=909345918351.dkr.ecr.ap-northeast-2.amazonaws.com/seoulwave:REPLACE_WITH_SUCCESSFUL_BACKEND_COMMIT_SHA
# Key-enabled frontend build passed CI and was pushed to ECR on 2026-11-06.
FRONTEND_IMAGE=909345918351.dkr.ecr.ap-northeast-2.amazonaws.com/seoul-wave-frontend:605740fa11d75560f31c932b9ffc01e609535864

# This EC2 has no database volume. Compose creates the named PostgreSQL volume on first approved start.
# Choose a fresh database password; the example value below is a placeholder, not a usable credential.
POSTGRES_DB=seoul_wave
POSTGRES_USER=seoul_wave_app
POSTGRES_PASSWORD=REPLACE_WITH_NEW_UNIQUE_DATABASE_PASSWORD

# Required production application settings.
APP_ENV=production
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
SITE_ACCESS_PASSWORDS=REPLACE_WITH_OPERATOR_PASSWORDS
# HTTP classroom demo approved by operator. Use true when browser-facing HTTPS is enabled.
SESSION_COOKIE_SECURE=false
SEOUL_CULTURE_API_KEY=REPLACE_WITH_SEOUL_OPEN_DATA_API_KEY
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=REPLACE_WITH_APPROVED_MODEL
# Optional; the application accepts empty and defaults radius to 5 km.
FERRY_STOP_COORDINATES_JSON=
EVENT_DESTINATION_RADIUS_KM=5

# Host Nginx already owns public port 80. Only the frontend binds to loopback; API and DB stay internal.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080

# Admin images share the existing seoulwave repository with distinct tags.
ADMIN_API_IMAGE=909345918351.dkr.ecr.ap-northeast-2.amazonaws.com/seoulwave:admin-api-REPLACE_WITH_ADMIN_SHA
ADMIN_FRONTEND_IMAGE=909345918351.dkr.ecr.ap-northeast-2.amazonaws.com/seoulwave:admin-frontend-REPLACE_WITH_ADMIN_SHA
ADMIN_API_KEY=REPLACE_WITH_RANDOM_URL_SAFE_32_TO_128_CHARACTERS
ADMIN_HTPASSWD_FILE=/home/ubuntu/seoul-wave-secrets/admin.htpasswd
