# Seoul Open Data Plaza cultural-events API general authentication key.
# Copy this file to .env and set the key locally. Do not commit .env.
SEOUL_CULTURE_API_KEY=
OPENAI_API_KEY=
# Set after the team confirms the OpenAI model to use.
OPENAI_MODEL=

# PostgreSQL for local Compose development.
POSTGRES_DB=
POSTGRES_USER=
# Set your local DB password in .env. Do not commit the real password.
POSTGRES_PASSWORD=

# Site access gate. Keep actual values in the ignored root .env file.
APP_ENV=development
SESSION_SECRET=
SITE_ACCESS_PASSWORDS=
SESSION_COOKIE_SECURE=false

# Optional: verified ferry-stop coordinates for destination distance filtering.
# Leave empty until the team confirms the coordinate source.
FERRY_STOP_COORDINATES_JSON=
EVENT_DESTINATION_RADIUS_KM=5

# Kakao Maps JavaScript key for the browser map. Do not use the REST API key here.
VITE_KAKAO_MAP_JS_KEY=
